{
  "name": "pdf-overlay-mvp",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json && vite build",
    "ios:add": "pnpm build && cap add ios",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "test:offline": "node scripts/verify-offline.mjs",
    "test:storage": "node scripts/verify-template-storage.mjs",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0 --port 4175"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
